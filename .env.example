# ─── ZENI Mode ────────────────────────────────────────────────────────────────
# 'private' → uses local Ollama at localhost:11434 (DEFAULT — zero data leaves machine)
# 'demo'    → uses Groq Cloud API (for Vercel deployment / portfolio)
VITE_MODE=private

# ─── Groq API Key ─────────────────────────────────────────────────────────────
# Only used when VITE_MODE=demo
# Get a free key at: https://console.groq.com
# Copy this file to .env and fill in your key
VITE_GROQ_API_KEY=your_groq_key_here
