# ─── ZENI Mode ────────────────────────────────────────────────────────────────
# 'private' → uses local Ollama at localhost:11434 (DEFAULT — zero data leaves machine)
# 'demo'    → uses Groq Cloud API (for Vercel deployment / portfolio)
VITE_MODE=private

# ─── Groq API Key ─────────────────────────────────────────────────────────────
# Only used by the Vercel serverless function when VITE_MODE=demo
# Get a free key at: https://console.groq.com
# Keep this server-side only. Do not prefix it with VITE_.
GROQ_API_KEY=your_groq_key_here
